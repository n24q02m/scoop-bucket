{
    "version": "4.24.0",
    "description": "Telegram client and bot MCP server and CLI",
    "homepage": "https://github.com/n24q02m/telegram",
    "license": "Apache-2.0",
    "depends": "uv",
    "url": [
        "https://files.pythonhosted.org/packages/c7/d8/63ea18bee72926ffa1521f778dd2f10dd3bdb74c47128b7a1d7ea017832d/n24q02m_telegram-4.24.0-py3-none-any.whl#/n24q02m_telegram-4.24.0-py3-none-any.whl",
        "https://raw.githubusercontent.com/n24q02m/scoop-bucket/main/locks/telegram-4.24.0.txt#/requirements.txt",
        "https://raw.githubusercontent.com/n24q02m/scoop-bucket/main/locks/telegram-4.24.0.build.txt#/build-requirements.txt"
    ],
    "hash": [
        "37a0535ca80377b2fcec9fb2040e3dced911e80994ea3b59270fad13fd83eaf1",
        "04c6e8bd318db69a9799ed16a0f8ce1e850e927117eb023a6a8a4398a60323b5",
        "b17e6212f8c6e839ac93c03a5b48793324b99a1b14c81fb7c77d9ff71223b23a"
    ],
    "installer": {
        "script": [
            "# Every dependency is pinned by hash: requirements.txt is the release tag's uv.lock exported",
            "# by bump.py, build-requirements.txt the build backends of dependencies that ship only an sdist.",
            "$py = \"$dir\\venv\\Scripts\\python.exe\"",
            "$pinned = @('--python', $py, '--require-hashes', '--only-binary', ':all:', '--no-deps', '--quiet')",
            "uv venv \"$dir\\venv\" --python 3.13 --quiet",
            "if ($LASTEXITCODE) { throw 'uv venv failed' }",
            "uv pip install @pinned -r \"$dir\\build-requirements.txt\"",
            "if ($LASTEXITCODE) { throw 'uv pip install (build backends) failed' }",
            "uv pip install @pinned --no-build-isolation -r \"$dir\\requirements.txt\"",
            "if ($LASTEXITCODE) { throw 'uv pip install (dependencies) failed' }",
            "uv pip install --python $py --no-deps --quiet (Get-ChildItem \"$dir\\*.whl\").FullName",
            "if ($LASTEXITCODE) { throw 'uv pip install (wheel) failed' }",
            "uv pip check --python $py --quiet",
            "if ($LASTEXITCODE) { throw 'uv pip check failed' }"
        ]
    },
    "bin": [
        [
            "venv\\Scripts\\telegram.exe",
            "telegram"
        ]
    ]
}
