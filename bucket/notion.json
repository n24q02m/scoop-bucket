{
    "version": "2.43.0",
    "description": "Notion workspace and document MCP server and CLI",
    "homepage": "https://github.com/n24q02m/notion",
    "license": "Apache-2.0",
    "depends": "nodejs",
    "url": [
        "https://registry.npmjs.org/@n24q02m/notion/-/notion-2.43.0.tgz",
        "https://raw.githubusercontent.com/n24q02m/scoop-bucket/main/locks/notion-2.43.0.package-lock.json#/package-lock.json"
    ],
    "hash": [
        "dbed8dc399c7af59bda609823786b1db00d71112e77a98c69cc813df2e2d9a19",
        "505d34a9e1203756457042db0e0bea72544ac49bb4374fcafc5a1bf2edeb6349"
    ],
    "extract_dir": "package",
    "installer": {
        "script": [
            "# Every dependency is pinned by integrity hash in package-lock.json, resolved by bump.py.",
            "Push-Location $dir",
            "npm ci --omit=dev --ignore-scripts --no-audit --no-fund --loglevel=error",
            "$code = $LASTEXITCODE",
            "Pop-Location",
            "if ($code) { throw 'npm ci failed' }",
            "# Run the node of the `nodejs` app this manifest depends on (a sibling app dir), not",
            "# whatever node comes first on PATH: the package's engines need a current Node.",
            "Set-Content -Path \"$dir\\notion.cmd\" -Value '@\"%~dp0..\\..\\nodejs\\current\\node.exe\" \"%~dp0bin\\cli.mjs\" %*' -Encoding ascii"
        ]
    },
    "bin": "notion.cmd"
}
