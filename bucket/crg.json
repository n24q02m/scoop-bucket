{
    "version": "3.32.0",
    "description": "Code review and AST symbol graph MCP server and CLI",
    "homepage": "https://github.com/n24q02m/crg",
    "license": "Apache-2.0",
    "depends": "uv",
    "url": "https://files.pythonhosted.org/packages/01/83/fa3d848a0cd610a61dfde6a069e9a8e79d25d2d972958c5e66fc6f8d22c4/n24q02m_crg-3.32.0-py3-none-any.whl#/n24q02m_crg-3.32.0-py3-none-any.whl",
    "hash": "7f166adefb812d2474a5e4a85ed725bc4ea78d1d25c7b3f0165ef09f9b0dcbb4",
    "installer": {
        "script": [
            "# The wheel pins only this package; its dependencies resolve from PyPI into a private venv.",
            "uv venv \"$dir\\venv\" --python 3.13 --quiet",
            "if ($LASTEXITCODE) { throw 'uv venv failed' }",
            "uv pip install --python \"$dir\\venv\\Scripts\\python.exe\" \"$dir\\$fname\" --quiet",
            "if ($LASTEXITCODE) { throw 'uv pip install failed' }"
        ]
    },
    "bin": [
        [
            "venv\\Scripts\\crg.exe",
            "crg"
        ]
    ]
}
