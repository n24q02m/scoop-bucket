{
    "version": "1.43.0",
    "description": "Unified IMAP and SMTP email MCP server and CLI",
    "homepage": "https://github.com/n24q02m/email",
    "license": "Apache-2.0",
    "depends": "nodejs",
    "url": "https://registry.npmjs.org/@n24q02m/email/-/email-1.43.0.tgz",
    "hash": "0f0bf1dde45b2270ee928a1b0e52904a435ec726c5ed1f3263c0de40abce12f1",
    "extract_dir": "package",
    "installer": {
        "script": [
            "Push-Location $dir",
            "npm install --omit=dev --no-audit --no-fund --loglevel=error",
            "$code = $LASTEXITCODE",
            "Pop-Location",
            "if ($code) { throw 'npm install failed' }",
            "Set-Content -Path \"$dir\\email.cmd\" -Value '@node \"%~dp0bin\\cli.mjs\" %*' -Encoding ascii"
        ]
    },
    "bin": "email.cmd"
}
